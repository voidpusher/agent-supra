# Copy to .env and fill in. Everything except DATABASE_URL and BASE_URL is optional.

# Postgres in production. Hosting providers' postgres:// URLs work as-is.
DATABASE_URL=sqlite:///supervisor.db
# The public URL people and agents use. https:// turns on secure cookies and HSTS.
BASE_URL=http://localhost:8000
APP_NAME=Agent Supra

# Set to false after launch if you want invite-only (create users with `agent-supra create-user`).
ALLOW_SIGNUP=true
# Delete runs older than this many days (0 = keep forever).
RETENTION_DAYS=30

# Rate limits (per server process).
RATE_LIMIT_EVENTS_PER_MIN=1200
RATE_LIMIT_AUTH_PER_MIN=10

# Server processes. 2 is fine for a small launch.
WEB_CONCURRENCY=2

# Email alerts (any SMTP provider: Resend, Postmark, SES, Gmail app password...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Error tracking (https://sentry.io, free tier is enough).
SENTRY_DSN=

# Extra model prices, USD per million tokens: {"model-name": [input, output]}
AGENT_SUPRA_PRICES=
