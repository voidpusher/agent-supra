{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "PostToolUse": [{"matcher": "Edit|Write|Bash", "hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "PostToolUseFailure": [{"matcher": "Edit|Write|Bash", "hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "agent-supra claude-hook", "timeout": 30}]}]
  }
}
